---
/**
 * Menu copy, fourth option (2026-10-14): the work as a climb. An elevation profile of Etna along the stone's own path
 * (base → summit, a little past it) is the timeline; milestones sit on it, and the scene's stone, small, rests on the
 * current one (it follows the [data-stone-anchor] box, and rolls when it moves). A little Sisyphus pushes it
 * (sisyphus-man.ts): a stick figure in the line's strokes, feet on the profile, posed on every frame the scene renders.
 * Wheel, ← → / ↑ ↓, a horizontal swipe or a click on a milestone moves it. Below the line, two columns: the milestone's
 * text, and its project card (linked to the project when it has a link; a video plays while its milestone is current).
 *
 * The profile is sampled at build time from public/terrain/etna.bin along the climb path of sisyphus.ts: START and
 * WOBBLE copy CONFIG.stone.start and CONFIG.stone.wobble, keep them in sync. The path's first stretch rises over a
 * bump and dips into a gully, so the line starts at that low point and only climbs from there.
 */
import { readFileSync } from "node:fs";
import { join } from "node:path";
import ProjectCard from "./ProjectCard.astro";
import { hint, type Hint } from "../data/projects";

interface Milestone {
  /** short label under the dot; omitted when the year repeats */
  label?: string;
  /** mono line over the text */
  when: string;
  text: string;
  /** the projects' pictures, shown in turn when there are several; their stacks go under the text */
  cards?: Hint[];
  /** a recorded talk about the work, linked under the text */
  talk?: { title: string; by: string; href: string };
  /** the stone waits here when the menu opens */
  start?: true;
}

const milestones: Milestone[] = [
  {
    label: "before",
    when: "Before · History",
    text: "I studied History, and the social sciences still shape how I look at data. A census, a parish register or a ship's log is always someone's record of real people and places, made for a reason and full of gaps. I try to read every dataset that way, and to show it to people honestly, including what it can't tell them.",
  },
  {
    label: "2014",
    when: "2014 · Freelance",
    text: "In 2014 I started building front ends and designing interfaces as a freelancer, with seven months of full-stack work at Credia in between. I was learning the trade by doing it, one website at a time, and getting hooked on the craft.",
  },
  {
    label: "2016",
    when: "2016 · Novelti",
    text: "At Novelti, in Madrid, I built near-real-time dashboards for data streaming in from connected devices. That's where I learned how much speed matters. When the screen keeps pace with the data, people start spotting patterns, and the odd reading that doesn't fit, without anyone pointing them out.",
  },
  {
    label: "2018",
    when: "2018–2022 · Vizzuality · Climate Watch, Trase, Marxan Cloud",
    text: "At Vizzuality I spent four years on questions much bigger than me. I built the charts and dashboards of Climate Watch, which tracks whether countries keep their climate commitments, the flows on Trase that follow Brazilian soy to the companies that buy it, and the groundwork of Marxan Cloud, for planning protected areas. I learned there that good data is only half the job. How you pick it and lay it out is often what moves people to act.",
    cards: [hint.climate, hint.soy, hint.marxan],
  },
  {
    when: "2018–2022 · Vizzuality · Half-Earth Project Map",
    text: "As technical lead I rebuilt the Half-Earth Project Map on ArcGIS, moving it off Cesium with a team of four developers and working closely with the scientists and designers. It shows where thousands of species live and which places would protect the most of them. We put a lot of effort into speed, because when a globe answers right away, people keep asking it things.",
    cards: [hint.species],
  },
  {
    label: "2022",
    when: "2022–2025 · endlessstudio · Global Fishing Watch",
    text: "In 2022 I went independent as endlessstudio. For Global Fishing Watch I helped move the ocean map onto the GPU, writing custom shaders and working with binary data. All so that anyone can follow a single vessel, or pull back to years of fishing across the whole sea, without waiting for the map.",
    cards: [hint.vessel],
    talk: {
      title: "Migrating visualizations from MapLibre to deck.gl",
      by: "OpenJS Foundation · YouTube",
      href: "https://youtu.be/eqTRG3tABZE",
    },
    start: true,
  },
  {
    when: "2022–2026 · endlessstudio · Tree Equity Score",
    text: "For American Forests I build Tree Equity Score, which maps the city blocks that live without shade, and I own the Python pipeline behind it, checked feature by feature from the source files to the tiles. It's data about heat, income and race, so it has to be exact, and it has to be told with care. City halls and neighborhood groups use it to argue for trees where people need them most.",
    cards: [hint.treeEquity],
  },
  {
    label: "now",
    when: "Now · endlessstudio · archaeo.studio",
    text: "Now I'm building archaeo.studio, a place where an excavation's records, maps and research live together. In a way it brings me back to History. I'm building it with AI as part of the process, but slowly and deliberately: first a model of the domain, then an explicit architecture, then the code, then checking that it all holds.",
    cards: [hint.archaeo],
  },
  {
    label: "next",
    when: "Next",
    text: "Next, I want to find out how far language models can take exploration. With them I can wander through datasets far too big to read on my own, ask questions in plain words and chase a hunch in an afternoon. I'd love to turn what I find there into tools that mean something to people, with new and more expressive ways of showing what the data holds, all the craft and art I can put into them, and always faithful to the sources. I don't know yet what they'll look like, and honestly that's the exciting part.",
  },
];

// --- the profile: elevation along the climb path, sampled from the baked terrain
const START = { u: 0.27, v: 0.73 }; // CONFIG.stone.start
const WOBBLE = { amplitude: 0.045, periods: 1.5 }; // CONFIG.stone.wobble
const PAST_SUMMIT = 1.14; // the line runs a little past the summit, so the peak reads as a peak
const SAMPLES = 200;

const meta = JSON.parse(readFileSync(join(process.cwd(), "public/terrain/etna.json"), "utf8"));
const raw = readFileSync(join(process.cwd(), "public/terrain/etna.bin"));
const data = new Uint16Array(raw.buffer.slice(raw.byteOffset, raw.byteOffset + raw.byteLength));
const n: number = meta.size;
const clamp01 = (x: number) => Math.min(1, Math.max(0, x));
const sample = (u: number, v: number) => {
  const x = clamp01(u) * (n - 1);
  const y = clamp01(v) * (n - 1);
  const x0 = Math.floor(x);
  const y0 = Math.floor(y);
  const x1 = Math.min(x0 + 1, n - 1);
  const y1 = Math.min(y0 + 1, n - 1);
  const fx = x - x0;
  const fy = y - y0;
  const h0 = data[y0 * n + x0] * (1 - fx) + data[y0 * n + x1] * fx;
  const h1 = data[y1 * n + x0] * (1 - fx) + data[y1 * n + x1] * fx;
  return h0 * (1 - fy) + h1 * fy;
};
let top = 0;
for (let i = 1; i < data.length; i++) if (data[i] > data[top]) top = i;
const summit = { u: (top % n) / (n - 1), v: Math.floor(top / n) / (n - 1) };
const toSummit = Math.hypot(summit.u - START.u, summit.v - START.v);
const dir = { u: (summit.u - START.u) / toSummit, v: (summit.v - START.v) / toSummit };
const smooth = (t: number) => t * t * (3 - 2 * t);
const elevationAt = (s: number) => {
  const k = clamp01(s / toSummit);
  const w = WOBBLE.amplitude * Math.sin(k * WOBBLE.periods * Math.PI * 2) * (1 - smooth(clamp01((k - 0.7) / 0.3)));
  return sample(START.u + dir.u * s - dir.v * w, START.v + dir.v * s + dir.u * w);
};
// start at the lowest point of the first half, so the timeline never goes downhill before the summit
let sMin = 0;
for (let s = 0; s < toSummit / 2; s += toSummit / 400) if (elevationAt(s) < elevationAt(sMin)) sMin = s;
const sMax = toSummit * PAST_SUMMIT;
const sAt = (i: number) => sMin + (i / (SAMPLES - 1)) * (sMax - sMin);
const elev = Array.from({ length: SAMPLES }, (_, i) => elevationAt(sAt(i)));
const eased = elev.map((_, i) => {
  const near = elev.slice(Math.max(0, i - 2), i + 3); // a five-sample average irons out the 78 m stair steps
  return near.reduce((a, b) => a + b, 0) / near.length;
});
const lo = Math.min(...eased);
const hi = Math.max(...eased);
const r2 = (x: number) => Math.round(x * 100) / 100;
// [x %, y %] inside the plot box; the plot stretches, so these stay valid at any size
const profile = eased.map((e, i) => [r2(1 + (i / (SAMPLES - 1)) * 98), r2(8 + (1 - (e - lo) / (hi - lo)) * 84)]);
const line = "M" + profile.map(([x, y]) => `${x * 10} ${y * 2.2}`).join(" L");
const area = `${line} L${profile[SAMPLES - 1][0] * 10} 220 L${profile[0][0] * 10} 220 Z`;

// milestones evenly spaced along the climb, the last one on the summit, the first far enough in that Sisyphus (behind
// the stone) still stands on the line; `at` = fractional index into the profile
const at = milestones.map((_, i) => {
  const s = sMin + (toSummit - sMin) * (0.07 + (0.93 * i) / (milestones.length - 1));
  return r2(((s - sMin) / (sMax - sMin)) * (SAMPLES - 1));
});
const pointAt = (f: number) => {
  const i = Math.min(Math.floor(f), SAMPLES - 2);
  const t = f - i;
  return [r2(profile[i][0] + (profile[i + 1][0] - profile[i][0]) * t), r2(profile[i][1] + (profile[i + 1][1] - profile[i][1]) * t)];
};
const dots = at.map(pointAt);
const pad = (i: number) => String(i + 1).padStart(2, "0");
const first = Math.max(0, milestones.findIndex((m) => m.start)); // where the stone waits when the menu opens
/** a milestone's stack: its projects' chips, each once */
const stackOf = (m: Milestone) => [...new Set((m.cards ?? []).flatMap((c) => c.stack))];
---

<!-- the line and its milestones; clicks in here never close the menu -->
<div
  class="timeline"
  data-timeline
  data-keep-menu
  data-profile={JSON.stringify(profile)}
  data-at={JSON.stringify(at)}
  data-first={first}
>
  <div class="tl-plot">
    <svg class="tl-profile" viewBox="0 0 1000 220" preserveAspectRatio="none" aria-hidden="true">
      <defs>
        <linearGradient id="tl-fill" x1="0" y1="0" x2="0" y2="1">
          <stop offset="0" stop-color="#f1e9d2" stop-opacity="0.14"></stop>
          <stop offset="1" stop-color="#f1e9d2" stop-opacity="0"></stop>
        </linearGradient>
      </defs>
      <path d={area} fill="url(#tl-fill)"></path>
      <path class="tl-line" d={line}></path>
    </svg>
    {
      milestones.map((m, i) => (
        <button
          class:list={["tl-dot", { "is-current": i === first, "is-passed": i < first }]}
          type="button"
          style={`left: ${dots[i][0]}%; top: ${dots[i][1]}%`}
          data-dot={i}
          aria-label={m.when}
          aria-current={i === first ? "step" : undefined}
        >
          {m.label && <span>{m.label}</span>}
        </button>
      ))
    }
    <!-- the scene's stone sits on this box: bottom centre on the line, as wide as it is -->
    <div class="tl-stone" data-stone-anchor style={`left: ${dots[first][0]}%; top: ${dots[first][1]}%`} aria-hidden="true"></div>
    <!-- and Sisyphus behind it, in plot px; the far arm and leg first, so the near ones and the head cover them -->
    <svg class="tl-man" data-man aria-hidden="true">
      <path class="tl-man-far" data-man-far></path>
      <path data-man-near></path>
      <circle class="tl-man-head" data-man-head r="0"></circle>
    </svg>
  </div>
  <p class="tl-help" aria-hidden="true">
    <span data-counter>{pad(first)} / {pad(milestones.length - 1)}</span><span>scroll or ← → to climb</span>
  </p>
</div>

<!-- menu-lead: shares the lead's reveal transition when the menu opens. Text and stack left, the milestone's pictures
     right (several take turns); each column stacks all milestones in one grid cell, so the layout never jumps -->
<div class="menu-lead tl-content">
  <div class="tl-steps" aria-live="polite">
    {
      milestones.map((m, i) => (
        <article
          class:list={["tl-step", { "is-current": i === first, "is-solo": !m.cards }]}
          data-step-text={i}
          aria-hidden={i === first ? undefined : "true"}
        >
          <p class="tl-when">{m.when}</p>
          <p class="tl-text">{m.text}</p>
          {m.talk && (
            <a
              class="tl-talk"
              href={m.talk.href}
              target="_blank"
              rel="noopener"
              aria-label={`Talk: ${m.talk.title}, ${m.talk.by} (opens in a new tab)`}
            >
              <span class="tl-talk-title">{m.talk.title}</span>
              <span class="tl-talk-by">{m.talk.by} ↗</span>
            </a>
          )}
          {m.cards && (
            <ul class="tl-stack" aria-label="Stack">
              {stackOf(m).map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          )}
        </article>
      ))
    }
  </div>
  <div class="tl-cards">
    {
      milestones.map(
        (m, i) =>
          m.cards && (
            <div class:list={["tl-card", { "is-current": i === first }]} data-step-card={i}>
              {m.cards.map((card, k) => {
                const Tag = card.href ? "a" : "div";
                return (
                  <Tag
                    class:list={["tl-shot", { "is-shown": k === 0 }]}
                    data-shot
                    href={card.href}
                    target={card.href && "_blank"}
                    rel={card.href && "noopener"}
                    aria-label={card.href ? `${card.project} (opens in a new tab)` : undefined}
                  >
                    <ProjectCard project={card} />
                  </Tag>
                );
              })}
              {m.cards.some((card) => card.video) && (
                <button class="tl-play" type="button" data-play data-keep-menu aria-label="Pause the video">
                  <svg viewBox="0 0 16 16" aria-hidden="true">
                    <path class="tl-play-pause" d="M4 3h2.6v10H4zM9.4 3H12v10H9.4z"></path>
                    <path class="tl-play-play" d="M5 3.2 13 8l-8 4.8z"></path>
                  </svg>
                </button>
              )}
            </div>
          ),
      )
    }
  </div>
</div>

<script>
  import { createSisyphus, drawSisyphus } from "../scripts/sisyphus-man";

  const root = document.querySelector<HTMLElement>("[data-timeline]");
  const scene = root?.closest<HTMLElement>(".sisyphus");
  const stone = root?.querySelector<HTMLElement>("[data-stone-anchor]");
  if (root && scene && stone) {
    const profile: [number, number][] = JSON.parse(root.dataset.profile ?? "[]");
    const at: number[] = JSON.parse(root.dataset.at ?? "[]");
    const dots = [...root.querySelectorAll<HTMLButtonElement>("[data-dot]")];
    const texts = [...document.querySelectorAll<HTMLElement>("[data-step-text]")];
    const cards = [...document.querySelectorAll<HTMLElement>("[data-step-card]")];
    const counter = root.querySelector<HTMLElement>("[data-counter]");
    const still = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const last = at.length - 1;
    const pad = (i: number) => String(i + 1).padStart(2, "0");
    let current = Number(root.dataset.first ?? 0);
    let pos = at[current]; // the stone's place on the profile, fractional sample index
    let raf = 0;

    /** [x %, y %] of the plot at fractional profile index f (clamped to the line's ends) */
    const pointAt = (f: number) => {
      f = Math.min(Math.max(f, 0), profile.length - 1);
      const i = Math.min(Math.floor(f), profile.length - 2);
      const t = f - i;
      return [profile[i][0] + (profile[i + 1][0] - profile[i][0]) * t, profile[i][1] + (profile[i + 1][1] - profile[i][1]) * t];
    };

    const put = (f: number) => {
      const [x, y] = pointAt(f);
      stone.style.left = `${x}%`;
      stone.style.top = `${y}%`;
    };

    const show = () => {
      dots.forEach((d, i) => {
        d.classList.toggle("is-current", i === current);
        d.classList.toggle("is-passed", i < current);
        if (i === current) d.setAttribute("aria-current", "step");
        else d.removeAttribute("aria-current");
      });
      texts.forEach((t, i) => {
        t.classList.toggle("is-current", i === current);
        if (i === current) t.removeAttribute("aria-hidden");
        else t.setAttribute("aria-hidden", "true");
      });
      cards.forEach((c) => c.classList.toggle("is-current", Number(c.dataset.stepCard) === current));
      if (counter) counter.textContent = `${pad(current)} / ${pad(last)}`;
      playCurrent();
    };

    const isOpen = () => scene.classList.contains("is-menu-open");

    // a video the visitor paused stays paused, here and on later visits to its milestone, until they play it again
    // (each video on its own); under reduced motion they all start paused
    const held = new Set(still ? cards : []);

    /** Only the current card's video plays, only while the menu is open, and not while held. */
    const playCurrent = () => {
      for (const c of cards) {
        const video = c.querySelector("video");
        if (!video) continue;
        const up = Number(c.dataset.stepCard) === current && isOpen();
        if (up && !held.has(c)) video.play().catch(() => {});
        else video.pause();
        if (!up) video.currentTime = 0;
        const button = c.querySelector<HTMLButtonElement>("[data-play]");
        button?.classList.toggle("is-held", held.has(c));
        button?.setAttribute("aria-label", held.has(c) ? "Play the video" : "Pause the video");
      }
    };

    // the button, or the video itself when its picture isn't a link, pauses and plays it
    for (const c of cards) {
      const hold = () => {
        if (!held.delete(c)) held.add(c);
        playCurrent();
      };
      c.querySelector("[data-play]")?.addEventListener("click", hold);
      const shot = c.querySelector("video")?.closest<HTMLElement>("[data-shot]");
      if (shot && shot.tagName !== "A") {
        shot.dataset.keepMenu = "";
        shot.addEventListener("click", hold);
      }
    }

    // --- Sisyphus, behind the stone. He is drawn on every frame the scene renders, so he and the stone move together
    // (the scene runs at 30–40 fps). With no scene (no WebGL, or still loading), he keeps his own clock.
    const plot = root.querySelector<HTMLElement>(".tl-plot");
    const man = root.querySelector<SVGSVGElement>("[data-man]");
    const near = root.querySelector<SVGPathElement>("[data-man-near]");
    const far = root.querySelector<SVGPathElement>("[data-man-far]");
    const head = root.querySelector<SVGCircleElement>("[data-man-head]");
    const sisyphus = createSisyphus();
    let width = 0; // the plot, px
    let height = 0;
    let radius = 0; // the stone, px
    let drawnAt = performance.now();
    let sceneAt = -Infinity;
    let manRaf = 0;
    const xFirst = profile[0][0];
    const xLast = profile[profile.length - 1][0];
    /** screen y of the line at plot x, px */
    const groundAt = (x: number) =>
      (pointAt((((100 * x) / width - xFirst) / (xLast - xFirst)) * (profile.length - 1))[1] * height) / 100;
    const drawMan = () => {
      const now = performance.now();
      const dt = still ? 0 : Math.min(0.1, (now - drawnAt) / 1000);
      drawnAt = now;
      if (!width || !near || !far || !head) return;
      const [x, y] = pointAt(pos);
      const pose = sisyphus.pose((x * width) / 100, (y * height) / 100, radius, groundAt, (xFirst * width) / 100, dt);
      drawSisyphus({ near, far, head }, pose);
    };
    const measure = () => {
      if (!plot) return;
      width = plot.clientWidth;
      height = plot.clientHeight;
      radius = stone.offsetWidth / 2;
      man?.style.setProperty("stroke-width", `${Math.max(1.4, radius * 0.12)}px`);
      sisyphus.reset();
      drawMan();
    };
    if (plot && man) {
      const resized = new ResizeObserver(measure);
      resized.observe(plot);
      resized.observe(stone);
      scene.querySelector("[data-sisyphus]")?.addEventListener("sisyphus:frame", () => {
        sceneAt = performance.now();
        if (isOpen()) drawMan();
      });
    }
    const manLoop = () => {
      manRaf = requestAnimationFrame(manLoop);
      if (performance.now() - sceneAt > 250) drawMan();
    };

    new MutationObserver(() => {
      playCurrent();
      cancelAnimationFrame(manRaf);
      if (isOpen() && man) manRaf = requestAnimationFrame(manLoop);
    }).observe(scene, { attributes: true, attributeFilter: ["class"] });

    // a milestone with several projects shows their pictures in turn while it is up (never under reduced motion)
    window.setInterval(() => {
      if (!isOpen() || still || document.hidden) return;
      const shots = [...(cards.find((c) => Number(c.dataset.stepCard) === current)?.querySelectorAll("[data-shot]") ?? [])];
      if (shots.length < 2) return;
      const shown = shots.findIndex((s) => s.classList.contains("is-shown"));
      shots.forEach((s, k) => s.classList.toggle("is-shown", k === (shown + 1) % shots.length));
    }, 3500);

    /** Roll the stone along the profile to milestone `next`: longer trips take a little longer. */
    const go = (next: number) => {
      next = Math.max(0, Math.min(last, next));
      if (next === current) return;
      const steps = Math.abs(next - current);
      current = next;
      show();
      cancelAnimationFrame(raf);
      const from = pos;
      const to = at[next];
      if (still) {
        pos = to;
        put(pos);
        return;
      }
      const duration = Math.min(700 + 160 * (steps - 1), 1800);
      const t0 = performance.now();
      const tick = (now: number) => {
        const k = Math.min(1, (now - t0) / duration);
        const e = k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2;
        pos = from + (to - from) * e;
        put(pos);
        if (k < 1) raf = requestAnimationFrame(tick);
      };
      raf = requestAnimationFrame(tick);
    };

    dots.forEach((d, i) => d.addEventListener("click", () => go(i)));

    document.addEventListener("keydown", (e) => {
      if (!isOpen() || e.altKey || e.ctrlKey || e.metaKey) return;
      const step = { ArrowRight: 1, ArrowDown: 1, PageDown: 1, ArrowLeft: -1, ArrowUp: -1, PageUp: -1 }[e.key];
      if (step) go(current + step);
      else if (e.key === "Home") go(0);
      else if (e.key === "End") go(last);
      else return;
      e.preventDefault();
    });

    // one step per wheel gesture: locked after a step until the wheel rests (trackpad inertia keeps it locked),
    // or for at most 900 ms when a mouse wheel keeps turning
    let acc = 0;
    let locked = 0;
    let rest = 0;
    document.addEventListener(
      "wheel",
      (e) => {
        if (!isOpen()) return;
        e.preventDefault();
        window.clearTimeout(rest);
        rest = window.setTimeout(() => {
          locked = 0;
          acc = 0;
        }, 160);
        if (locked && performance.now() - locked < 900) return;
        acc += Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
        if (Math.abs(acc) > 30) {
          go(current + Math.sign(acc));
          locked = performance.now();
          acc = 0;
        }
      },
      { passive: false },
    );

    // touch: a horizontal swipe (vertical ones are left to scrolling)
    let x0 = 0;
    let y0 = 0;
    document.addEventListener("touchstart", (e) => {
      x0 = e.touches[0].clientX;
      y0 = e.touches[0].clientY;
    }, { passive: true });
    document.addEventListener("touchend", (e) => {
      if (!isOpen()) return;
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) go(current + (dx < 0 ? 1 : -1));
    }, { passive: true });
  }
</script>

<style>
  .timeline {
    display: grid;
    gap: 0.6rem;
    width: min(72rem, 100%);
