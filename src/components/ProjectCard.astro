---
/**
 * A project card: its image (or video, which the holder plays), then project, where · when · role, what was built and
 * the stack as chips. Shown on hover by ProjectHint, and as the right column of the timeline. Ends on its markup so it
 * can sit inside running text (Astro keeps template whitespace).
 */
import type { Hint } from "../data/projects";

interface Props {
  project: Hint;
}
const { project: h } = Astro.props;
---

<style>
  /* picture (or video) over a monospaced tag, on a solid panel */
  .bio-card {
    display: grid;
    overflow: hidden;
    border: 1px solid rgba(241, 233, 210, 0.16);
    border-radius: 3px;
    background: rgba(20, 22, 25, 0.95);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
    white-space: normal;
  }

  .bio-card :is(img, video) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 2 / 1;
    object-fit: cover;
  }

  /* below the picture: project and role in the stone tag's mono, what was built, then the stack as chips */
  .bio-tag {
    display: grid;
    gap: 0.5rem;
    padding: 1.1rem 1.3rem 1.3rem;
    border-top: 1px solid rgba(241, 233, 210, 0.12);
    text-align: left;
  }

  .bio-name,
  .bio-meta,
  .bio-stack {
    font-family: var(--font-mono);
    text-transform: uppercase;
  }

  /* led by the stone tag's short line, in the hint's pink */
  .bio-name {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    color: var(--landing-cream);
  }

  .bio-name::before {
    content: "";
    display: inline-block;
    width: 0.9rem;
    height: 1px;
    margin-right: 0.6rem;
    vertical-align: middle;
    background: var(--landing-pink);
  }

  .bio-meta {
    margin-top: -0.2rem;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    color: rgba(241, 233, 210, 0.55);
  }

  .bio-work {
    font-size: 0.94rem;
    font-weight: 400;
    line-height: 1.45;
    color: rgba(241, 233, 210, 0.9);
  }

  .bio-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: 0.15rem;
    font-size: 0.66rem;
    letter-spacing: 0.08em;
  }

  .bio-stack span {
    padding: 0.22rem 0.45rem;
    border: 1px solid rgba(241, 233, 210, 0.22);
    border-radius: 2px;
    color: var(--landing-cream);
  }

</style>

<span class="bio-card">{h.video ? <video poster={h.image} width="1088" height="544" muted loop playsinline preload="none"><source src={h.video.webm} type="video/webm" /><source src={h.video.mp4} type="video/mp4" /></video> : <img src={h.image} alt="" width="800" height="400" loading="lazy" decoding="async" />}<span class="bio-tag"><span class="bio-name">{h.project}</span><span class="bio-meta">{h.meta}</span><span class="bio-work">{h.work}</span><span class="bio-stack">{h.stack.map((t) => <span>{t}</span>)}</span></span></span>